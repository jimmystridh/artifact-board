{
  "apiVersion": "run.googleapis.com/v1",
  "kind": "Job",
  "metadata": {
    "name": "artifact-board-build",
    "namespace": "134099336412",
    "labels": {
      "app": "artifact-board",
      "environment": "pilot"
    }
  },
  "spec": {
    "template": {
      "spec": {
        "taskCount": 1,
        "parallelism": 1,
        "template": {
          "spec": {
            "serviceAccountName": "artifact-board-build@dev-innov-cm.iam.gserviceaccount.com",
            "maxRetries": 0,
            "timeoutSeconds": "120",
            "containers": [
              {
                "name": "worker",
                "image": "europe-north2-docker.pkg.dev/dev-innov-cm/cloud-run-source-deploy/artifact-board-pilot@sha256:1e4443654b9a87c57d050340529eddc4b4ddda50288cede2d42a6500f4b7c304",
                "resources": {
                  "limits": {
                    "cpu": "1",
                    "memory": "1Gi"
                  }
                },
                "env": [
                  {
                    "name": "ARTIFACT_STORE",
                    "value": "firestore"
                  },
                  {
                    "name": "GOOGLE_CLOUD_PROJECT",
                    "value": "dev-innov-cm"
                  },
                  {
                    "name": "ARTIFACT_DATABASE",
                    "value": "artifact-board-pilot"
                  },
                  {
                    "name": "ARTIFACT_BUCKET",
                    "value": "dev-innov-cm-artifact-board-pilot"
                  },
                  {
                    "name": "ARTIFACT_ORIGIN",
                    "value": "https://artifact-board-pilot-134099336412.europe-north2.run.app"
                  },
                  {
                    "name": "ARTIFACT_NODE_BIN_DIR",
                    "value": "/usr/local/bin"
                  },
                  {
                    "name": "ARTIFACT_BUILD_MODE",
                    "value": "trusted-host"
                  }
                ]
              }
            ]
          }
        }
      }
    }
  }
}
